# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Shown in the app header, PDF and reminders
NEXT_PUBLIC_GYM_NAME=Varasgav Fitness

# Password for /admin
ADMIN_PASSWORD=change-me

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret added to the attendance QR so the scan URL can't be guessed.
# Changing it means you must print a new QR poster.
GYM_QR_KEY=

# Monthly fee in rupees (optional, pre-fills the payment form and reminders)
MONTHLY_FEE=800

# Public URL of the app, used in the QR poster (e.g. https://varasgavfitness.in)
APP_URL=

# ---- Google Sheets storage (leave empty locally to use .data/db.json) ----
# The ID is the long part of the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON, keeping the \n sequences
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
